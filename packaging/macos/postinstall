#!/usr/bin/env bash
set -u

APP_DIR="/Applications/CipherDock"
VENV_DIR="$APP_DIR/.venv"
LOG_FILE="/var/log/cipherdock-installer.log"

log() {
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >> "$LOG_FILE"
}

find_python() {
  for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

PYTHON_BIN="$(find_python || true)"
if [ -z "${PYTHON_BIN:-}" ]; then
  log "Python 3 was not found. Install Python 3.11+ and run: python3 -m venv $VENV_DIR"
  exit 0
fi

log "Using Python at $PYTHON_BIN"

if "$PYTHON_BIN" -m venv "$VENV_DIR" >> "$LOG_FILE" 2>&1; then
  "$VENV_DIR/bin/python" -m pip install --no-deps -e "$APP_DIR" >> "$LOG_FILE" 2>&1 || log "Editable install failed"
  WHEEL_DIR="$APP_DIR/packaging/macos/wheels"
  if [ -d "$WHEEL_DIR" ] && ls "$WHEEL_DIR"/*.whl >/dev/null 2>&1; then
    "$VENV_DIR/bin/python" -m pip install --no-index --find-links "$WHEEL_DIR" -r "$APP_DIR/requirements.txt" >> "$LOG_FILE" 2>&1 || \
      "$VENV_DIR/bin/python" -m pip install -r "$APP_DIR/requirements.txt" >> "$LOG_FILE" 2>&1 || \
      log "Dynamic tools install failed"
  else
    "$VENV_DIR/bin/python" -m pip install -r "$APP_DIR/requirements.txt" >> "$LOG_FILE" 2>&1 || log "Dynamic tools install failed"
  fi
  for tool in frida frida-ls-devices objection; do
    if [ -x "$VENV_DIR/bin/$tool" ]; then
      log "Verified dynamic tool: $tool"
    else
      log "Missing dynamic tool after install: $tool"
    fi
  done
else
  log "Virtual environment creation failed"
fi

mkdir -p /usr/local/bin

cat > /usr/local/bin/cipherdock <<'EOF'
#!/usr/bin/env bash
APP_DIR="/Applications/CipherDock"
PYTHON_BIN="$APP_DIR/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3)"
fi
export PATH="$APP_DIR/.venv/bin:$PATH"
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export IRE_ZERO_FRIDA_PATH="${IRE_ZERO_FRIDA_PATH:-$APP_DIR/.venv/bin/frida}"
export IRE_ZERO_FRIDA_LS_DEVICES_PATH="${IRE_ZERO_FRIDA_LS_DEVICES_PATH:-$APP_DIR/.venv/bin/frida-ls-devices}"
export IRE_ZERO_OBJECTION_PATH="${IRE_ZERO_OBJECTION_PATH:-$APP_DIR/.venv/bin/objection}"
exec "$PYTHON_BIN" -m ire_zero "$@"
EOF
chmod 0755 /usr/local/bin/cipherdock

cat > /usr/local/bin/cipherdock-workbench <<'EOF'
#!/usr/bin/env bash
APP_DIR="/Applications/CipherDock"
WORKSPACE="${HOME}/Library/Application Support/CipherDock/workbench-data"
PORT="${CIPHERDOCK_PORT:-8765}"
PYTHON_BIN="$APP_DIR/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3)"
fi
mkdir -p "$WORKSPACE"
if command -v lsof >/dev/null 2>&1 && lsof -tiTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "CipherDock Workbench appears to already be running at http://127.0.0.1:${PORT}/cipherdock-workbench.html"
  echo "Run cipherdock-workbench-restart to restart it, or cipherdock-workbench-stop to stop it."
  echo "Use CIPHERDOCK_PORT=8766 cipherdock-workbench to start another instance."
  exit 0
fi
export PATH="$APP_DIR/.venv/bin:$PATH"
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export IRE_ZERO_FRIDA_PATH="${IRE_ZERO_FRIDA_PATH:-$APP_DIR/.venv/bin/frida}"
export IRE_ZERO_FRIDA_LS_DEVICES_PATH="${IRE_ZERO_FRIDA_LS_DEVICES_PATH:-$APP_DIR/.venv/bin/frida-ls-devices}"
export IRE_ZERO_OBJECTION_PATH="${IRE_ZERO_OBJECTION_PATH:-$APP_DIR/.venv/bin/objection}"
exec "$PYTHON_BIN" "$APP_DIR/webapp.py" \
  --port "$PORT" \
  --html "$APP_DIR/cipherdock-workbench.html" \
  --workspace "$WORKSPACE" \
  "$@"
EOF
chmod 0755 /usr/local/bin/cipherdock-workbench

cat > /usr/local/bin/cipherdock-workbench-stop <<'EOF'
#!/usr/bin/env bash
set -u

PORT="${CIPHERDOCK_PORT:-8765}"
AGENT_PLIST="${HOME}/Library/LaunchAgents/com.cipherdock.workbench.plist"
AGENT_LABEL="gui/$(id -u)/com.cipherdock.workbench"

stopped=0

if command -v launchctl >/dev/null 2>&1 && [ -f "$AGENT_PLIST" ]; then
  if launchctl print "$AGENT_LABEL" >/dev/null 2>&1; then
    launchctl bootout "gui/$(id -u)" "$AGENT_PLIST" >/dev/null 2>&1 || true
    echo "Stopped CipherDock Workbench LaunchAgent."
    stopped=1
  fi
fi

if ! command -v lsof >/dev/null 2>&1; then
  if [ "$stopped" -eq 0 ]; then
    echo "lsof is unavailable; no port listener could be checked."
  fi
  exit 0
fi

pids="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
if [ -z "$pids" ]; then
  if [ "$stopped" -eq 0 ]; then
    echo "No CipherDock Workbench listener found on port ${PORT}."
  fi
  exit 0
fi

echo "$pids" | while IFS= read -r pid; do
  [ -z "$pid" ] && continue
  kill "$pid" 2>/dev/null || true
done

sleep 1
remaining="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
if [ -n "$remaining" ]; then
  echo "$remaining" | while IFS= read -r pid; do
    [ -z "$pid" ] && continue
    kill -9 "$pid" 2>/dev/null || true
  done
fi

echo "Stopped CipherDock Workbench on port ${PORT}."
EOF
chmod 0755 /usr/local/bin/cipherdock-workbench-stop

cat > /usr/local/bin/cipherdock-workbench-restart <<'EOF'
#!/usr/bin/env bash
set -e

cipherdock-workbench-stop
exec cipherdock-workbench "$@"
EOF
chmod 0755 /usr/local/bin/cipherdock-workbench-restart

log "CipherDock installation completed"
exit 0
